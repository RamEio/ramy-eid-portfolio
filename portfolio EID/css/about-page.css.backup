/* About Page Specific Styles */

/* Photography Hero Section */
.photography-hero {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Full Page Mosaic Background */
.photography-mosaic-fullpage {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    cursor: pointer;
    transition: transform 0.3s ease;
}

.photography-mosaic-fullpage:hover {
    transform: scale(1.02);
}

.photography-mosaic-fullpage.clicked {
    transform: scale(0.98);
}

/* Content Overlay */
.photography-content-overlay {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 1400px;
    padding: 0 2rem;
}

.photography-content {
    text-align: center;
    max-width: 900px;
    padding: 3rem;
    position: relative;
    z-index: 2;
    background: linear-gradient(rgba(10, 10, 10, 0.3), rgba(10, 10, 10, 0.4));
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    box-shadow: 
        0 8px 32px rgba(0, 0, 0, 0.5),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    animation: fadeInUp 1s ease-out;
}

.photography-hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    margin-bottom: var(--space-6);
    color: white;
    line-height: 1.2;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.9);
}

.photography-hero-subtitle {
    font-size: var(--text-xl);
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: var(--space-4);
    font-weight: 500;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8);
}

.photography-hero-description {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.95);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.9);
}

/* Photography Mosaic Gallery */
.photography-mosaic-container {
    position: relative;
    width: 100%;
    padding: 0;
    overflow: hidden;
}

.photography-mosaic {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 0;
    width: 100%;
    height: 80vh;
    overflow: hidden;
    border-radius: 0;
    position: relative;
    cursor: pointer;
    transition: transform 0.3s ease;
}

.photography-mosaic:hover {
    transform: scale(1.02);
}

.photography-mosaic.clicked {
    transform: scale(0.98);
}

.mosaic-item {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.mosaic-item:hover {
    transform: scale(1.02);
    z-index: 10;
}

.mosaic-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.3s ease;
    display: block;
}

.mosaic-item:hover img {
    transform: scale(1.1);
}

.mosaic-overlay {
    display: none;
}

.mosaic-overlay h3 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
}

.mosaic-overlay p {
    font-size: 0.9rem;
    opacity: 0.9;
}

/* Mosaic Item Sizes - 3x3 Grid Layouts */
.mosaic-item.xlarge {
    grid-column: span 2;
    grid-row: span 2;
}

.mosaic-item.large {
    grid-column: span 2;
    grid-row: span 1;
}

.mosaic-item.medium {
    grid-column: span 1;
    grid-row: span 1;
}

.mosaic-item.small {
    grid-column: span 1;
    grid-row: span 1;
}

.mosaic-item.xsmall {
    grid-column: span 1;
    grid-row: span 1;
}

/* Grid Layout Variations */
.mosaic-layout-1 {
    grid-template-areas: 
        "xlarge xlarge medium"
        "xlarge xlarge small"
        "large large xsmall";
}

.mosaic-layout-2 {
    grid-template-areas: 
        "large large xlarge"
        "medium small xlarge"
        "xsmall xsmall xlarge";
}

.mosaic-layout-3 {
    grid-template-areas: 
        "xlarge xlarge large"
        "xlarge xlarge large"
        "medium small xsmall";
}

/* YouTube Section */
.youtube-section {
    padding: 4rem 0;
    background: linear-gradient(rgba(10, 10, 10, 0.3), rgba(10, 10, 10, 0.4)),
                url('assets/hobbies/backgrounds/youtube-bg.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    position: relative;
    overflow: hidden;
    min-height: 400px;
}

.youtube-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.youtube-intro {
    text-align: center;
    margin-bottom: 3rem;
}

.youtube-intro h3 {
    font-size: 2rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1rem;
}

.youtube-intro p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
}

.youtube-showcase {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
}

.youtube-embed {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16/9;
}

.youtube-embed iframe {
    width: 100%;
    height: 100%;
    border: none;
}

.youtube-stats {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    justify-content: center;
}

.stat-item {
    text-align: center;
    padding: 1.5rem;
    background: rgba(107, 70, 193, 0.1);
    border-radius: var(--radius-md);
    border: 1px solid rgba(107, 70, 193, 0.2);
}

.stat-number {
    display: block;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--accent-primary);
    margin-bottom: 0.5rem;
}

.stat-label {
    font-size: 1rem;
    color: var(--text-secondary);
    font-weight: 500;
}

.youtube-skills {
    text-align: center;
}

.youtube-skills h4 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
}

.skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
}

.skill-tag {
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    color: white;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    font-weight: 500;
}

/* Services Section */
.services-section {
    padding: 4rem 0;
    background: transparent;
    position: relative;
    overflow: hidden;
}

.services-section {
    background: linear-gradient(rgba(10, 10, 10, 0.5), rgba(10, 10, 10, 0.6)),
                url('assets/hobbies/backgrounds/services-bg.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    min-height: 400px;
}

.services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
    min-height: 80vh;
}

.service-card {
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    overflow: hidden;
    text-align: center;
}

.service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary));
    transform: scaleX(0);
    transition: transform 0.3s ease;
}

.service-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(107, 70, 193, 0.2);
}

.service-card:hover::before {
    transform: scaleX(1);
}

.service-icon {
    font-size: 3rem;
    margin-bottom: 1.5rem;
    display: block;
}

.service-card h3 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1rem;
}

.service-card p {
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: 1rem;
    margin-bottom: 1.5rem;
}

.service-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 2rem;
}

.feature-tag {
    background: rgba(107, 70, 193, 0.1);
    color: var(--accent-primary);
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid rgba(107, 70, 193, 0.2);
}

.service-cta {
    display: inline-block;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    color: white;
    padding: 1rem 2rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.service-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(107, 70, 193, 0.3);
}

/* Hero Section */
.hero-about {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(rgba(10, 10, 10, 0.4), rgba(10, 10, 10, 0.6)),
                url('https://images.pexels.com/photos/1933239/pexels-photo-1933239.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    overflow: hidden;
}

.hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, rgba(107, 70, 193, 0.05) 0%, transparent 70%);
    pointer-events: none;
    /* Additional subtle blur effect */
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
}

.hero-content {
    text-align: center;
    max-width: 900px;
    padding: var(--space-16);
    position: relative;
    z-index: 2;
    /* Enhanced glass effect with more transparency and blur */
    background: rgba(26, 26, 26, 0.3);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-xl);
    box-shadow: 
        0 8px 32px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    animation: fadeInUp 1s ease-out;
}

.hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    margin-bottom: var(--space-6);
    color: var(--text-primary);
    line-height: 1.2;
    /* Enhanced text readability with subtle shadow */
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
}

.hero-subtitle {
    font-size: var(--text-xl);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    font-weight: 500;
    /* Enhanced text readability with subtle shadow */
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
}

.hero-description {
    font-size: var(--text-lg);
    color: var(--text-primary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    /* Enhanced text readability with subtle shadow */
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
}

.scroll-indicator {
    margin-top: 2rem;
    animation: bounce 2s infinite;
}

.scroll-arrow {
    display: inline-block;
    width: 20px;
    height: 20px;
    border-right: 2px solid var(--accent-primary);
    border-bottom: 2px solid var(--accent-primary);
    transform: rotate(45deg);
}



/* Personal Passions Section */
.passions-section {
    padding: 4rem 0;
    background: transparent;
    position: relative;
    overflow: hidden;
}

.passions-section {
    background: linear-gradient(rgba(10, 10, 10, 0.3), rgba(10, 10, 10, 0.4)),
                url('assets/hobbies/backgrounds/passions-bg.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    min-height: 400px;
}

.passions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.passion-card {
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    overflow: hidden;
}

.passion-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary));
    transform: scaleX(0);
    transition: transform 0.3s ease;
}

.passion-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(107, 70, 193, 0.2);
}

.passion-card:hover::before {
    transform: scaleX(1);
}

.passion-icon {
    font-size: 3rem;
    margin-bottom: 1.5rem;
    display: block;
}

.passion-card h3 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1rem;
}

.passion-card p {
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: 1rem;
    margin-bottom: 1.5rem;
}

.passion-details {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.passion-tag {
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    color: white;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 500;
    opacity: 0.9;
}



/* How Passions Influence Design Section */




/* Call-to-Action Section */
.cta-section {
    padding: 4rem 0;
    background: linear-gradient(rgba(10, 10, 10, 0.3), rgba(10, 10, 10, 0.4)),
                url('assets/hobbies/backgrounds/cta-bg.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    position: relative;
    overflow: hidden;
    min-height: 400px;
}

.cta-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.cta-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
}

.cta-description {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2.5rem;
}

.cta-buttons {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
}

.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 2px solid transparent;
}

.btn-primary {
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    color: white;
    box-shadow: 0 10px 20px rgba(107, 70, 193, 0.3);
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(107, 70, 193, 0.4);
}

.btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border-color: var(--accent-primary);
}

.btn-secondary:hover {
    background: var(--accent-primary);
    color: white;
    transform: translateY(-2px);
}

.btn-icon {
    font-size: 1.2rem;
}

/* Animations */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes backgroundFloat {
    0%, 100% {
        transform: translateY(0px);
    }
    50% {
        transform: translateY(-20px);
    }
}

@keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
        transform: translateY(0);
    }
    40% {
        transform: translateY(-10px);
    }
    60% {
        transform: translateY(-5px);
    }
}

/* Mobile carousel animation - REMOVED DUPLICATE - Now in main.css */

/* Responsive Design */
@media (max-width: 768px) {
    .photography-hero {
        flex-direction: column;
        padding: 0 1rem;
        height: auto;
        min-height: 80vh;
    }
    
    /* Mobile-only: Replace complex grid with homepage-style carousel */
    .photography-mosaic-fullpage {
        display: flex !important;
        flex-direction: column !important;
        gap: 0 !important;
        height: auto !important;
        width: 100% !important;
        overflow: hidden !important;
    }
    
    /* Mobile carousel rows - homepage style */
    .mobile-carousel-row {
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: nowrap !important;
        gap: 0 !important;
        animation: scrollCarousel 300s linear infinite !important; /* ULTRA SLOW - 5 minutes */
        width: max-content !important;
        padding: 0 !important;
        max-width: none !important;
        height: 200px !important;
        overflow: hidden !important;
        align-items: flex-start !important;
        margin-bottom: 0 !important;
    }
    
    /* Pause animation on hover */
    .mobile-carousel-row:hover {
        animation-play-state: paused;
    }
    
    /* Mobile carousel items - homepage style */
    .mobile-carousel-item {
        position: relative !important;
        overflow: hidden !important;
        border-radius: 0 !important;
        transition: all var(--transition-normal) !important;
        cursor: pointer !important;
        flex-shrink: 0 !important;
        margin: 0 !important;
        border: none !important;
    }
    
    .mobile-carousel-item.xlarge {
        width: 300px;
        height: 200px;
        flex-shrink: 0;
    }
    
    .mobile-carousel-item.large {
        width: 250px;
        height: 200px;
        flex-shrink: 0;
    }
    
    .mobile-carousel-item.medium {
        width: 200px;
        height: 200px;
        flex-shrink: 0;
    }
    
    .mobile-carousel-item.small {
        width: 150px;
        height: 200px;
        flex-shrink: 0;
    }
    
    .mobile-carousel-item.xsmall {
        width: 100px;
        height: 200px;
        flex-shrink: 0;
    }
    
    /* Mobile carousel image styling */
    .mobile-carousel-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--transition-normal);
        border-radius: 0 !important;
        will-change: transform;
        backface-visibility: hidden;
        transform: translateZ(0);
        aspect-ratio: 16/9;
        background: rgba(26, 26, 26, 0.1);
    }
    
    /* Mobile carousel hover effects */
    .mobile-carousel-item:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }
    
    .mobile-carousel-item:hover img {
        transform: scale(1.05);
    }
    
    .photography-content-overlay {
        order: 1;
        padding: 2rem 0;
    }
    
    .photography-content {
        padding: 2rem 1.5rem;
        /* Mobile card opacity and blur effects - EXACTLY matching web version */
        background: linear-gradient(rgba(10, 10, 10, 0.3), rgba(10, 10, 10, 0.4)) !important;
        backdrop-filter: blur(20px) saturate(180%) !important;
        -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 16px !important;
        box-shadow: 
            0 8px 32px rgba(0, 0, 0, 0.5),
            inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;
        /* Ensure same opacity as web version */
        opacity: 1 !important;
    }
    
    /* ULTRA-SPECIFIC override for photography-content with glass-effect-heavy */
    .photography-content.glass-effect-heavy {
        background: linear-gradient(rgba(10, 10, 10, 0.3), rgba(10, 10, 10, 0.4)) !important;
        backdrop-filter: blur(20px) saturate(180%) !important;
        -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 16px !important;
        box-shadow: 
            0 8px 32px rgba(0, 0, 0, 0.5),
            inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;
        opacity: 1 !important;
    }
    
    /* ULTRA-AGGRESSIVE animation speed override */
    .photography-mosaic-fullpage .mobile-carousel-row {
        animation: scrollCarousel 300s linear infinite !important;
    }
    
    /* Even more specific override */
    body .photography-mosaic-fullpage .mobile-carousel-row {
        animation: scrollCarousel 300s linear infinite !important;
    }
    
    /* NUCLEAR OPTION - Override ALL possible animation conflicts */
    .mobile-carousel-row {
        animation: scrollCarousel 300s linear infinite !important;
        animation-duration: 300s !important;
        animation-timing-function: linear !important;
        animation-iteration-count: infinite !important;
    }
    
    .photography-mosaic {
        height: 400px;
    }
    
    .mosaic-item.xlarge {
        grid-area: span 2 / span 2;
        height: 200px;
    }
    
    .mosaic-item.large {
        grid-area: span 1 / span 2;
        height: 150px;
    }
    
    .mosaic-item.medium {
        grid-area: span 1 / span 1;
        height: 120px;
    }
    
    .mosaic-item.small {
        grid-area: span 1 / span 1;
        height: 100px;
    }
    
    .mosaic-item.xsmall {
        grid-area: span 1 / span 1;
        height: 80px;
    }
    
    /* Enhanced mobile touch interaction for mosaic items */
    .mosaic-item {
        touch-action: manipulation;
        -webkit-tap-highlight-color: rgba(107, 70, 193, 0.1);
        transition: transform 0.2s ease-in-out;
    }
    
    .mosaic-item:active {
        transform: scale(0.95);
    }
    
    /* Mobile-specific grid layout for better mosaic appearance */
    .mosaic-item img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        border-radius: 0 !important;
        display: block !important;
    }
    
    /* Mobile mosaic item styling - no gaps, seamless */
    .mosaic-item {
        border-radius: 0 !important;
        overflow: hidden !important;
    }
    
    .youtube-showcase {
        grid-template-columns: 1fr;
        gap: 2rem;
    }
    
    /* Mobile YouTube optimization */
    .youtube-embed {
        border-radius: var(--radius-lg);
        overflow: hidden;
        aspect-ratio: 16/9;
        /* Mobile-specific video player settings */
        touch-action: manipulation;
    }
    
    .youtube-embed iframe {
        width: 100%;
        height: 100%;
        border: none;
        /* Mobile video player optimization */
        /* Note: iframe attributes are set in HTML, not CSS */
    }
    
    .services-grid {
        grid-template-columns: 1fr;
    }
    

    
    .passions-grid,
    .influence-grid {
        grid-template-columns: 1fr;
    }
    
    .passion-card,
    .influence-card,
    .service-card {
        padding: 2rem 1.5rem;
        /* Enhanced touch targets for mobile */
        min-height: 44px;
        touch-action: manipulation;
    }
    
    .cta-buttons {
        flex-direction: column;
        align-items: center;
    }
    
    .btn {
        width: 100%;
        max-width: 300px;
        justify-content: center;
        /* Enhanced mobile touch targets */
        min-height: 44px;
        touch-action: manipulation;
        -webkit-tap-highlight-color: rgba(107, 70, 193, 0.1);
    }
}

@media (max-width: 480px) {
    /* Small screen mobile carousel optimization */
    .mobile-carousel-item.xlarge {
        width: 250px;
        height: 200px;
    }
    
    .mobile-carousel-item.large {
        width: 200px;
        height: 200px;
    }
    
    .mobile-carousel-item.medium {
        width: 150px;
        height: 200px;
    }
    
    .mobile-carousel-item.small {
        width: 120px;
        height: 200px;
    }
    
    .mobile-carousel-item.xsmall {
        width: 80px;
        height: 200px;
    }
    
    .photography-hero-title {
        font-size: 2rem;
        /* Enhanced mobile typography */
        line-height: 1.2;
        letter-spacing: -0.02em;
        /* Mobile text shadow for better readability */
        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.9);
    }
    
    .photography-hero-subtitle {
        font-size: 1.1rem;
        /* Mobile text shadow for better readability */
        text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8);
    }
    
    .photography-hero-description {
        font-size: 1rem;
        /* Mobile text shadow for better readability */
        text-shadow: 0 1px 5px rgba(0, 0, 0, 0.9);
    }
    
    .youtube-content {
        padding: 2rem 1.5rem;
    }
    
    .passion-card,
    .influence-card,
    .service-card {
        padding: 1.5rem 1rem;
    }
    
    .cta-content {
        padding: 2rem 1.5rem;
    }
    
    .cta-title {
        font-size: 2rem;
    }
    
    .passion-tag,
    .feature-tag {
        font-size: 0.7rem;
        padding: 0.2rem 0.6rem;
    }
    
    /* Enhanced mobile touch feedback */
    .passion-card:active,
    .service-card:active,
    .influence-card:active {
        transform: scale(0.98);
        transition: transform 0.1s ease-in-out;
    }
    
    /* Mobile-specific hover disable */
    .passion-card:hover,
    .service-card:hover,
    .influence-card:hover {
        transform: none;
    }
}
